{
  "name": "nightlife-connect",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nightlife Connect — Tu noche, segura y conectada. Web app (PWA) preparada para Capacitor.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:blocks:7-8": "vitest run src/features/matching src/features/chats src/features/places src/features/attendance src/features/events src/adapters/supabase/places.test.ts src/adapters/supabase/social.test.ts src/features/admin/model/venue.test.ts src/features/admin/model/venue-csv.test.ts src/features/admin/components/ProviderQuotas.test.tsx",
    "test:realtime:8": "node --use-system-ca scripts/block8-realtime.mjs",
    "test:billing:9": "node --use-system-ca scripts/block9-billing.mjs",
    "test:erasure:9": "node --use-system-ca scripts/block9-erasure.mjs",
    "test:network:9": "node --use-system-ca scripts/block9-network.mjs",
    "test:watch": "vitest",
    "tokens": "node scripts/generate-theme-css.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.50.0",
    "mapbox-gl": "^3.32.0",
    "motion": "^13.5.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
