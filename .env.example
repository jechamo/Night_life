# Copy to .env.local. Only PUBLIC values belong in the frontend (PRD 3.2):
# Supabase URL + publishable key, Mapbox public token and Stripe publishable key.
# Secrets live in Supabase Secrets and are used only from Edge Functions.

# Public origin used to build return URLs for external flows (Yoti, Stripe, Spotify).
# Defaults to the current origin when empty.
VITE_APP_URL=

# Supabase (Block 5+). Without them the app runs fully on mocks (tests, offline dev).
VITE_SUPABASE_URL=https://ocrpfeqfqzchhrghqcfb.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_JetP7Fc8NCdWhUBYZveOEA_MFeKHu3E
