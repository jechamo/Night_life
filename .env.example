# Copy to .env.local. Only PUBLIC values belong in the frontend (PRD 3.2):
# Supabase URL + publishable key. Mapbox is reserved by RPC; Stripe is server-side.
# Secrets live in Supabase Secrets and are used only from Edge Functions.

# Origin for platform deep links. Defaults to the current web origin when empty.
# Edge verifier returns use APP_ORIGIN; Stripe currently has a fixed production origin.
VITE_APP_URL=

# Supabase (Block 5+). Mocks without these values are allowed only in development/tests.
VITE_SUPABASE_URL=https://ocrpfeqfqzchhrghqcfb.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_JetP7Fc8NCdWhUBYZveOEA_MFeKHu3E
